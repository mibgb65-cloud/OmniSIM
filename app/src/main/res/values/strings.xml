    <string name="background_limitation">Reminder checks are approximate. Android and manufacturer battery policies may delay background work.</string>
    <string name="privacy_local_first_title">Local-first by design</string>
    <string name="privacy_local_first_body">SIM details, renewal dates, notes, history, and settings are stored in OmniSIM’s private app storage. OmniSIM does not upload this information.</string>
    <string name="privacy_permissions_section">Permissions</string>
    <string name="privacy_notification_title">Notifications</string>
    <string name="privacy_notification_body">Used only for upcoming and overdue renewal reminders. On Android 13 and later, OmniSIM asks before sending notifications.</string>
    <string name="permission_status_allowed">Allowed</string>
    <string name="permission_status_not_allowed">Not allowed</string>
    <string name="permission_status_not_required">Not required</string>
    <string name="open_system_permissions">Open system permission settings</string>
    <string name="privacy_network_title">Network access</string>
    <string name="privacy_network_body">Internet access is used to download public daily rates from the European Central Bank, monthly rates from the European Commission, and official OmniSIM release information from GitHub. These requests contain no SIM records, phone numbers, prices, or dates; standard network metadata such as your IP address is visible to those services.</string>
    <string name="privacy_files_title">Backups, restore, and external websites</string>
    <string name="privacy_files_body">Backup and restore use Android’s document picker, so OmniSIM can access only files you choose and does not request broad storage access. Exported backups contain your SIM data and should be kept secure. Renewal links and update downloads open in your browser without adding stored SIM data to the URL.</string>
    <string name="privacy_unused_permissions_title">Permissions OmniSIM does not use</string>
    <string name="privacy_unused_permissions_body">OmniSIM does not request contacts, SMS, phone, call log, location, camera, microphone, or broad storage access.</string>
    <string name="privacy_deletion_title">Deleting your data</string>
    <string name="privacy_deletion_body">Deleting a SIM also deletes its renewal history. Uninstalling OmniSIM removes its local app data; previously exported backup files remain where you saved them.</string>
    <string name="usage_guide_intro_title">The essentials</string>
    <string name="usage_guide_intro_body">OmniSIM keeps renewal information in one place and helps you see which SIM needs attention next.</string>
    <string name="usage_step_add_title">Add a SIM</string>
    <string name="usage_step_add_body">Tap +, then enter a display name, carrier, and next renewal date. Add the phone number, country, cycle, price, and website when useful.</string>
    <string name="usage_step_check_title">Check what is due</string>
    <string name="usage_step_check_body">Home shows the nearest active renewal first. The SIM page lets you search and filter active, due-soon, overdue, and archived records.</string>
    <string name="usage_step_renew_title">Record a renewal</string>
    <string name="usage_step_renew_body">Choose Mark as renewed, confirm the actual renewal date, and review the proposed next date. If a cycle is set, the next date is calculated from the actual renewal date.</string>
    <string name="usage_step_cost_title">Review costs</string>
    <string name="usage_step_cost_body">Usage shows recurring costs by currency and a total converted to your default currency. ECB daily rates are supplemented by European Commission monthly rates, with a recent copy kept for offline use.</string>
    <string name="usage_step_reminder_title">Set reminders</string>
    <string name="usage_step_reminder_body">Choose reminder offsets in Settings and allow notifications when prompted. Android battery policies can make reminder timing approximate.</string>
    <string name="usage_step_backup_title">Back up or restore</string>
    <string name="usage_step_backup_body">Use Export backup before changing phones or clearing app data. Restore validates the selected backup before replacing the current local records.</string>
    <string name="usage_tips_title">Good to know</string>
    <string name="usage_tips_body">Archive SIMs you no longer actively use, enable phone-number masking for shared screens, and set the default currency used by the combined cost total.</string>
